# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored — NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL — AdventureWorks
JDBC_URL=jdbc:postgresql://adventureworks-postgres:5432/postgres
DB_USER=postgres
DB_PASSWORD=My_password1

# HDFS
HDFS_BASE=hdfs://namenode:9000/datalake/raw
HDFS_CURATED=hdfs://namenode:9000/datalake/curated

# Hive Metastore
HIVE_METASTORE_URI=thrift://hive-metastore:9083
HIVE_WAREHOUSE_DIR=hdfs://namenode:9000/user/hive/warehouse

# Airflow (optional — only needed if running Airflow)
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:////tmp/airflow/airflow.db
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW_HOME=/tmp/airflow
